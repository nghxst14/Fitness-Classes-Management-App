# Variáveis de ambiente de PRODUÇÃO (Railway → Variables).
# Este ficheiro é só um exemplo/documentação — NÃO pôr segredos reais aqui.
# Em desenvolvimento local não é preciso nada disto (há defaults seguros).

# Chave secreta do Django. Gerar uma nova e única (ver GUIA_COMANDOS.md).
DJANGO_SECRET_KEY=troca-por-uma-chave-longa-e-aleatoria

# Produção: tem de ser False.
DJANGO_DEBUG=False

# Domínio(s) que servem a app, separados por vírgula. O Railway dá um domínio
# tipo "nome.up.railway.app".
DJANGO_ALLOWED_HOSTS=nome.up.railway.app

# Mesmo domínio, com https:// à frente (para os formulários/admin funcionarem).
DJANGO_CSRF_TRUSTED_ORIGINS=https://nome.up.railway.app

# Número de WhatsApp real do Sérgio (indicativo + número, sem "+" nem espaços).
SERGIO_WHATSAPP=351XXXXXXXXX

# DATABASE_URL é injetada automaticamente pelo Railway ao adicionar o
# PostgreSQL — não é preciso defini-la à mão.
